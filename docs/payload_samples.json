{
  "_說明": "UNS 系統常見 MQTT Payload 格式範例集",
  "_用途": "供 Agent 做 Schema 推斷與 Payload 分類時參考",
  "_分類": ["遙測數據", "設備狀態", "告警事件", "控制指令", "批次紀錄", "OEE 指標"],

  "遙測數據_範例": {
    "_描述": "高頻率感測器數據，通常 QoS 0，不 retain",
    
    "單值遙測": {
      "topic": "Factory/Site1/SMT/Line1/Printer/Telemetry/Temperature",
      "payload": {
        "value": 25.3,
        "unit": "°C",
        "quality": "good",
        "timestamp": "2024-01-15T08:30:00.000+08:00"
      }
    },
    
    "多值遙測": {
      "topic": "Factory/Site1/SMT/Line1/ReflowOven/Telemetry/ZoneTemps",
      "payload": {
        "zones": [
          {"zone": 1, "name": "預熱區", "setpoint": 180.0, "actual": 179.5},
          {"zone": 2, "name": "浸潤區", "setpoint": 220.0, "actual": 219.8},
          {"zone": 3, "name": "迴焊區", "setpoint": 260.0, "actual": 260.2}
        ],
        "unit": "°C",
        "timestamp": "2024-01-15T08:30:00.000+08:00"
      }
    },
    
    "振動數據 (高頻)": {
      "topic": "Factory/Site1/Assembly/Line1/Motor1/Telemetry/Vibration",
      "payload": {
        "axis": "X",
        "rms_velocity": 2.8,
        "peak_acceleration": 5.1,
        "unit_velocity": "mm/s",
        "unit_acceleration": "g",
        "fft_dominant_freq": 120.5,
        "timestamp": "2024-01-15T08:30:00.050+08:00"
      }
    }
  },

  "設備狀態_範例": {
    "_描述": "設備運行狀態，狀態變更時發送，QoS 1，retain true",
    
    "基本狀態": {
      "topic": "Factory/Site1/SMT/Line1/Printer/Status/MachineState",
      "payload": {
        "state": "running",
        "sub_state": "producing",
        "mode": "auto",
        "program_name": "PCB-A001-Rev3",
        "operator_id": "OP-001",
        "shift": "day",
        "since": "2024-01-15T08:00:00+08:00"
      },
      "_state_枚舉值": ["running", "idle", "changeover", "maintenance", "fault", "offline"]
    },

    "連線狀態 (LWT)": {
      "_描述": "使用 MQTT Last Will and Testament 機制偵測設備斷線",
      "topic": "Factory/Site1/SMT/Line1/Printer/Status/Connection",
      "payload": {
        "connected": true,
        "client_id": "printer-line1-001",
        "ip_address": "192.168.1.101",
        "firmware_version": "3.2.1",
        "last_seen": "2024-01-15T08:30:00+08:00"
      },
      "lwt_payload": {
        "connected": false,
        "client_id": "printer-line1-001",
        "disconnected_at": "auto"
      }
    }
  },

  "告警事件_範例": {
    "_描述": "設備告警，事件觸發時發送，QoS 1，retain true（當前有效告警）",
    
    "單一告警": {
      "topic": "Factory/Site1/SMT/Line1/ReflowOven/Alarm/ActiveAlarms",
      "payload": {
        "alarm_id": "ALM-2024-0115-001",
        "code": "REFLOW-T01",
        "severity": "critical",
        "category": "temperature",
        "message": "迴焊區溫度超過上限值 (265°C > 262°C)",
        "source": "Zone3.Temperature",
        "current_value": 265.0,
        "threshold": 262.0,
        "unit": "°C",
        "triggered_at": "2024-01-15T09:15:00+08:00",
        "acknowledged": false,
        "acknowledged_by": null
      },
      "_severity_枚舉值": ["info", "warning", "critical", "emergency"]
    },

    "品質事件": {
      "topic": "Factory/Site1/QualityControl/Inspection1/AOI/Event/DefectDetected",
      "payload": {
        "event_type": "defect_detected",
        "board_serial": "PCB-2024-01150001",
        "work_order": "WO-2024-0042",
        "defect": {
          "type": "solder_bridge",
          "component_ref": "U3",
          "pad": "pin_14",
          "location": {"x_mm": 45.2, "y_mm": 30.1},
          "image_ref": "img/2024/0115/defect_001.jpg",
          "confidence": 0.95
        },
        "action_required": "目視複檢",
        "timestamp": "2024-01-15T08:35:00+08:00"
      }
    }
  },

  "控制指令_範例": {
    "_描述": "下行控制指令，手動觸發，QoS 1，不 retain",
    
    "設備控制": {
      "topic": "Factory/Site1/SMT/Line1/Printer/Command/Control",
      "payload": {
        "command": "set_parameter",
        "request_id": "CMD-2024-0115-001",
        "parameters": {
          "squeegee_pressure": 5.5,
          "squeegee_speed": 40,
          "separation_speed": 3.0
        },
        "reason": "品質微調 — 錫膏厚度偏薄",
        "requested_by": "OP-001",
        "requested_at": "2024-01-15T10:00:00+08:00"
      }
    },

    "指令回應": {
      "topic": "Factory/Site1/SMT/Line1/Printer/Command/Response",
      "payload": {
        "request_id": "CMD-2024-0115-001",
        "status": "accepted",
        "executed_at": "2024-01-15T10:00:01+08:00",
        "message": "參數已更新"
      },
      "_status_枚舉值": ["accepted", "rejected", "queued", "timeout", "error"]
    }
  },

  "批次紀錄_範例": {
    "_描述": "批次/工單相關數據，用於生產追溯",
    
    "批次開始": {
      "topic": "Factory/Site1/SMT/Line1/Batch/Start",
      "payload": {
        "batch_id": "B-2024-0115-001",
        "work_order": "WO-2024-0042",
        "product_id": "PCB-A001",
        "revision": "Rev3",
        "planned_qty": 500,
        "bom_version": "BOM-A001-R3-V2",
        "recipe_name": "PCB-A001-Rev3-SMT",
        "started_at": "2024-01-15T08:00:00+08:00",
        "started_by": "OP-001"
      }
    },

    "批次結束": {
      "topic": "Factory/Site1/SMT/Line1/Batch/End",
      "payload": {
        "batch_id": "B-2024-0115-001",
        "work_order": "WO-2024-0042",
        "planned_qty": 500,
        "actual_qty": 498,
        "good_qty": 490,
        "ng_qty": 8,
        "yield_rate": 0.984,
        "started_at": "2024-01-15T08:00:00+08:00",
        "ended_at": "2024-01-15T16:30:00+08:00",
        "duration_hours": 8.5,
        "ended_by": "OP-003"
      }
    }
  },

  "OEE_指標_範例": {
    "_描述": "設備綜合效率 (Overall Equipment Effectiveness)，定期計算",

    "即時 OEE": {
      "topic": "Factory/Site1/SMT/Line1/Metrics/OEE",
      "payload": {
        "period": "current_shift",
        "shift": "day",
        "availability": 0.92,
        "performance": 0.88,
        "quality": 0.984,
        "oee": 0.797,
        "planned_production_time_min": 480,
        "actual_run_time_min": 441.6,
        "downtime_events": [
          {"reason": "換料", "duration_min": 18.0, "count": 3},
          {"reason": "品質異常停機", "duration_min": 12.0, "count": 1},
          {"reason": "設備故障", "duration_min": 8.4, "count": 1}
        ],
        "calculated_at": "2024-01-15T12:00:00+08:00"
      }
    }
  },

  "二進位數據_範例": {
    "_描述": "部分舊設備可能發送非 JSON 的二進位或純文字數據",
    
    "Modbus 原始值": {
      "topic": "Factory/Site1/Utilities/Compressor1/Raw/ModbusRegisters",
      "_payload_hex": "00 64 01 F4 00 0A FF FF",
      "_解讀": "Register[0]=100 (壓力 10.0 bar), Register[1]=500 (流量 50.0 L/min), Register[2]=10 (溫度 10°C), Register[3]=65535 (無效值)",
      "_建議": "應在 Edge Gateway 層轉換為 JSON 後再發布到 UNS"
    },

    "純文字狀態": {
      "topic": "Factory/Site1/Utilities/HVAC/Zone1/Raw/StatusString",
      "_payload_text": "COOLING:ON|TEMP:22.5|HUM:45.2|FAN:HIGH",
      "_建議": "應由 Edge Gateway 解析為結構化 JSON"
    }
  }
}
