# =============================================================================
# UNS Platform — Environment Variables
# =============================================================================
# 複製為 .env 使用：cp .env.example .env
# =============================================================================

# --- TimescaleDB ---
POSTGRES_USER=uns_admin
POSTGRES_PASSWORD=uns_dev_password
POSTGRES_DB=uns_timeseries

# --- EMQX ---
EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=public

# --- Backend (local dev → localhost) ---
DATABASE_URL=postgresql+asyncpg://uns_admin:uns_dev_password@localhost:5432/uns_timeseries
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
EMQX_API_URL=http://localhost:18083

# --- Data Engine (local dev → localhost) ---
DATA_ENGINE_MQTT_HOST=localhost
DATA_ENGINE_MQTT_PORT=1883
DATA_ENGINE_DB_URL=postgresql://uns_admin:uns_dev_password@localhost:5432/uns_timeseries
