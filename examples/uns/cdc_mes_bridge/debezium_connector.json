{
    "name": "mes-cdc-postgresql",
    "config": {
        "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
        "database.hostname": "mes-postgres",
        "database.port": "5432",
        "database.user": "mes",
        "database.password": "mes_password",
        "database.dbname": "mes_db",
        "database.server.name": "mes",
        "plugin.name": "pgoutput",
        "table.include.list": "public.event_tracking,public.lot,public.equipment",
        "column.include.list": "public.event_tracking.*,public.lot.lot_id,public.lot.state,public.lot.equipment_id,public.lot.line_id,public.lot.good_qty,public.lot.ng_qty,public.lot.updated_at,public.equipment.equipment_id,public.equipment.state,public.equipment.mode,public.equipment.current_lot,public.equipment.line_id,public.equipment.area_id,public.equipment.updated_at",
        "transforms": "route",
        "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
        "transforms.route.regex": "mes\\.public\\.(.*)",
        "transforms.route.replacement": "dbserver1.cdc.$1",
        "slot.name": "mes_uns_slot",
        "publication.name": "mes_uns_publication",
        "snapshot.mode": "initial",
        "heartbeat.interval.ms": "10000",
        "topic.prefix": "mes",
        "_comment": "Debezium 會監聽 event_tracking, lot, equipment 三張表的變更，產生 JSON Change Event 到 Kafka topic，再由 Transform Service 轉換成 UNS MQTT 格式"
    }
}